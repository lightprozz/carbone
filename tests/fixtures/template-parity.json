    {
      "id": "array-map",
      "feature": "formatter",
      "source": "test/test.formatter.js",
      "reference_api": "builder.buildXML",
      "template": "<xml>{d.values:arrayMap(' | ',':',name,id)}</xml>",
      "data": {
        "values": [
          {
            "id": 2,
            "name": "car"
          },
          {
            "id": 3,
            "name": "plane"
          }
        ]
      },
      "options": {},
      "expected": "<xml>car:2 | plane:3</xml>"
    },
    {
      "id": "md5",
      "feature": "formatter",
      "source": "formatters/string.js:md5",
      "reference_api": "builder.buildXML",
      "template": "<xml>{d.text:md5}</xml>",
      "data": {
        "text": "carbone"
      },
      "options": {},
      "expected": "<xml>a4d811e0fa9c5ee6828d57194a1e46a4</xml>"
    },
    {
      "id": "formatter-escaping",
      "feature": "escaping",
      "source": "test/test.builder.buildXML.js",
      "reference_api": "builder.buildXML",
      "template": "<xml>{d.text:upperCase}</xml>",
      "data": {
        "text": "a&b <c> \"d\" 'e'"
      },
      "options": {},
      "expected": "<xml>A&amp;B &lt;C&gt; \"D\" 'E'</xml>",
      "note": "Node field substitution escapes ampersand and angle brackets but leaves both quote characters unchanged; preserve this compatibility discrepancy explicitly."
    },
    {
      "id": "translation-selected-language",
      "feature": "translation",
      "source": "lib/parser.js:translate",
      "reference_api": "carbone.renderXML",
      "template": "<xml>{t(Hello)} {d.name}</xml>",
      "data": {
        "name": "Ada"
      },
      "options": {
        "lang": "fr",
        "translations": {
          "fr": {
            "Hello": "Bonjour"
          },
          "en": {
            "Hello": "Hi"
          }
        }
      },
      "expected": "<xml>Bonjour Ada</xml>"
    },
    {
      "id": "translation-fallback",
      "feature": "translation",
      "source": "lib/parser.js:translate",
      "reference_api": "carbone.renderXML",
      "template": "<xml>{t(Missing)}|{t(Empty)}</xml>",
      "data": {},
      "options": {
        "lang": "fr",
        "translations": {
          "fr": {
            "Empty": ""
          }
        }
      },
      "expected": "<xml>Missing|Empty</xml>"
    },
    {
      "id": "translation-escaping",
      "feature": "translation",
      "source": "lib/parser.js:translate",
      "reference_api": "carbone.renderXML",
      "template": "<xml>{t(Hello)}</xml>",
      "data": {},
      "options": {
        "lang": "fr",
        "translations": {
          "fr": {
            "Hello": "A&B <C> \"D\" 'E'"
          }
        }
      },
      "expected": "<xml>A&amp;B &lt;C&gt; \"D\" &apos;E&apos;</xml>",
      "note": "Node translation escaping differs from field substitution: apostrophes become &apos;, while double quotes remain unchanged."
    },
    {
      "id": "docx-split-run",
      "feature": "office-split-run",
      "source": "test/test.parser.js:removeXMLInsideMarkers",
      "reference_api": "carbone.renderXML",
      "template": "<w:p><w:r><w:t>{d.na</w:t></w:r><w:r><w:t>me}</w:t></w:r></w:p>",
      "data": {
        "name": "Ada"
      },
      "options": {},
      "expected": "<w:p><w:r><w:t>Ada</w:t></w:r><w:r><w:t></w:t></w:r></w:p>",
      "note": "Node moves intervening XML tags after the substituted marker and preserves the empty second run."
    },
    {
      "id": "odt-split-run",
      "feature": "office-split-run",
      "source": "test/test.parser.js:removeXMLInsideMarkers",
      "reference_api": "carbone.renderXML",
      "template": "<text:p><text:span>{d.na</text:span><text:span>me}</text:span></text:p>",
      "data": {
        "name": "Ada"
      },
      "options": {},
      "expected": "<text:p><text:span>Ada</text:span><text:span></text:span></text:p>",
      "note": "Node moves intervening XML tags after the substituted marker and preserves the empty second run."
    }
  ]
}
