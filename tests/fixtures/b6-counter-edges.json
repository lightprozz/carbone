          "start": 9
        },
        {
          "name": "C",
          "other": "c",
          "longerName": "cc",
          "start": 0
        }
      ],
      "options": {
        "complement": {}
      },
      "expected": "<xml><r>5</r><r>6</r><r>7</r></xml>",
